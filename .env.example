# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o GitHub; este arquivo traz só os nomes das variáveis.

# API do CRM
CRM_API_URL=
CRM_API_KEY=

# ERP no Supabase (Session pooler), com o usuário erp_reader
ERP_DB_HOST=
ERP_DB_PORT=
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=

# Caminho do arquivo do DuckDB
DUCKDB_PATH=
